{
  "Gateway": {
    "MonolithHost": "localhost",
    "MonolithPort": 5100,
    "AuthHost": "localhost",
    "AuthPort": 5001,
    "CatalogHost": "localhost",
    "CatalogPort": 5002,
    "BookingHost": "localhost",
    "BookingPort": 5003
  },
  "Jwt": {
    "Key": "",
    "Issuer": "SportsBookingAuth",
    "Audience": "SportsBookingClients"
  },
  "RateLimits": {
    "Login": 10,
    "Booking": 10,
    "General": 100,
    "Anonymous": 30
  },
  "Cache": {
    "CatalogTtlSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:8080"
    ]
  },
  "Services": {
    "CatalogUrl": "http://localhost:5002",
    "BookingUrl": "http://localhost:5003"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
